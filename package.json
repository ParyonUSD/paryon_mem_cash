{
  "name": "@paryonusd/mem-cash",
  "version": "0.1.0",
  "description": "In-memory Bitcoin Cash node with a Fulcrum-compatible Electrum server, for simulated-network tests. A fork of mem-cash 0.0.9.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepare": "pnpm build",
    "build": "rm -rf dist && tsc",
    "test": "vitest",
    "test:unit": "vitest --run",
    "lint": "eslint .",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json && eslint ."
  },
  "keywords": [
    "bitcoin-cash",
    "electrum",
    "fulcrum",
    "mempool",
    "paryon"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParyonUSD/paryon_mem_cash.git"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.12.4"
}
